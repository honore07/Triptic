{
  "id": "9aeaaa35be081366",
  "name": "TRIPTIC — Agent 5 : rapport hebdo de conformité TDM",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyWeek",
              "hour": 9,
              "minute": 30,
              "weekday": 1
            }
          ]
        }
      },
      "id": "c5000000-0000-4000-8000-000000000001",
      "name": "Chaque lundi 09:30",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://82.25.118.185:3001/api/places/stats",
        "options": {}
      },
      "id": "c5000000-0000-4000-8000-000000000002",
      "name": "Stats conformité",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "// Rapport de conformité TDM (roadmap 6.7).\n// Suite du flux : Email Resend (toujours) + alerte Telegram si anomalie.\n// L'audit trail détaillé (décision par fiche) est dans les logs Pino\n// (grep '\"agent\":\"compliance\"' sur le VPS).\nconst s = $input.first().json;\nconst t = s.tdm ?? {};\nconst rapport = `# TRIPTIC — Conformité TDM (${new Date().toLocaleDateString('fr-FR')})\\n\\n` +\n  `**Fiches web actives : ${t.web_active ?? 0}** · en quarantaine (revue Jules) : ${t.web_pending ?? 0}\\n\\n` +\n  `Sources suivies : ${t.sources_total ?? 0} · opt-out détectés et exclus : ${t.sources_opted_out ?? 0}\\n\\n` +\n  `Rappels : aucune fiche web n'est publiée sans l'agent de conformité ;\\n` +\n  `les opt-outs sont re-vérifiés à chaque fetch ; audit trail complet dans Pino.\\n`;\nreturn [{ json: { rapport, ...t } }];"
      },
      "id": "c5000000-0000-4000-8000-000000000003",
      "name": "Formater le rapport",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'TRIPTIC <noreply@hakoe-alsace.com>', to: ['jules.million07@gmail.com'], subject: 'TRIPTIC — Conformité TDM (rapport hebdo)', text: $json.rapport }) }}",
        "options": {}
      },
      "id": "c5000000-0000-4000-8000-000000000004",
      "name": "Email Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 180],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Resend API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.web_pending ?? 0 }}",
              "operation": "larger",
              "value2": 0
            },
            {
              "value1": "={{ $json.sources_opted_out ?? 0 }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        },
        "combineOperation": "any"
      },
      "id": "c5000000-0000-4000-8000-000000000005",
      "name": "Anomalie ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [960, 420]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=TRIPTIC — Alerte conformité TDM : {{ $json.web_pending ?? 0 }} fiche(s) web en quarantaine à revoir, {{ $json.sources_opted_out ?? 0 }} source(s) en opt-out exclue(s). Détail dans le rapport envoyé par email.",
        "additionalFields": {}
      },
      "id": "c5000000-0000-4000-8000-000000000006",
      "name": "Alerte Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1200, 420],
      "credentials": {
        "telegramApi": {
          "name": "Telegram TRIPTIC Bot"
        }
      }
    }
  ],
  "connections": {
    "Chaque lundi 09:30": {
      "main": [
