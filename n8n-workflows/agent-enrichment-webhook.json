{
  "name": "TRIPTIC — Zone auto-enrichie",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "triptic-enrich",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Webhook enrichissement",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [260, 300],
      "webhookId": "triptic-enrich"
    },
    {
      "parameters": {
        "jsCode": "// Événement envoyé par server/src/services/enrichment.ts après remplissage\n// automatique d'une zone sous-couverte (event: zone_enriched).\n// Suite du flux : notification Telegram + email Resend.\nconst body = $input.first().json.body ?? $input.first().json;\nreturn [{ json: {\n  event: body.event ?? 'zone_enriched',\n  zone: body.zone ?? 'inconnue',\n  lieux_ajoutes: body.added ?? 0,\n  horodatage: new Date().toISOString(),\n} }];"
      },
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Formater l'événement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'TRIPTIC <noreply@hakoe-alsace.com>', to: ['jules.million07@gmail.com'], subject: 'TRIPTIC — Zone auto-enrichie : ' + $json.zone, text: 'Zone « ' + $json.zone + ' » enrichie automatiquement : ' + $json.lieux_ajoutes + ' lieu(x) ajouté(s).\\nHorodatage : ' + $json.horodatage }) }}",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Email Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 200],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Resend API"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=TRIPTIC — Zone « {{ $json.zone }} » auto-enrichie : {{ $json.lieux_ajoutes }} lieu(x) ajouté(s).",
        "additionalFields": {}
      },
      "id": "b1000000-0000-4000-8000-000000000004",
      "name": "Notifier Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [780, 400],
      "credentials": {
        "telegramApi": {
          "name": "Telegram TRIPTIC Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook enrichissement": {
      "main": [
        [
          {
            "node": "Formater l'événement",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formater l'événement": {
      "main": [
        [
          {
            "node": "Email Resend",
            "type": "main",
            "index": 0
          },
          {
            "node": "Notifier Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
