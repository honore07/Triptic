    {
      "parameters": {
        "jsCode": "// Événement envoyé par server/src/repo/users.ts quand un compte est supprimé\n// (DELETE /api/me, droit à l'effacement). Tout autre envoi est ignoré :\n// ce workflow efface un contact, il ne doit jamais agir sur un doute.\nconst body = $input.first().json.body ?? $input.first().json;\nif (body.event !== 'account_deleted' || !body.email) { return []; }\nreturn [{ json: { email: String(body.email).toLowerCase() } }];"
      },
      "id": "c2000000-0000-4000-8000-000000000012",
      "name": "Vérifier l'événement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "={{ 'https://api.brevo.com/v3/contacts/' + encodeURIComponent($json.email) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "c2000000-0000-4000-8000-000000000013",
